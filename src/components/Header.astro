---
import Monogram from './Monogram.astro';

interface Props {
  compact?: boolean;
  current?: 'notes' | 'about';
}
const { compact = false, current } = Astro.props;
---
<div class="site-head" style={compact ? 'padding-top:32px' : undefined}>
  <a class="brand" href="/">
    <Monogram />
    <div>
      <div class="site-title"><span>An's blog</span></div>
      {!compact && <div class="site-tag">những ghi chép của An Việt Trung</div>}
    </div>
  </a>
  <nav class="site-nav">
    <a href="/" aria-current={current === 'notes' ? 'page' : undefined}>Notes</a>
    <a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About</a>
    <a href="/rss.xml">RSS</a>
  </nav>
</div>
