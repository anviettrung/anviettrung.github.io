---
import type { CollectionEntry } from 'astro:content';
import { postHref, formatDate } from '../lib/posts';

interface Props {
  posts: CollectionEntry<'posts'>[];
}
const { posts } = Astro.props;
---
<ul class="-mx-3">
  {posts.map((post) => (
    <li>
      <a
        href={postHref(post.id, post.data.date)}
        class="group flex flex-col gap-0.5 rounded-lg px-3 py-3 transition-colors hover:bg-surface sm:flex-row sm:items-baseline sm:gap-6"
      >
        <time datetime={post.data.date.toISOString()} class="shrink-0 font-mono text-[0.8rem] text-faint tabular-nums sm:w-24">
          {formatDate(post.data.date)}
        </time>
        <span class="font-medium transition-colors group-hover:text-accent">{post.data.title}</span>
      </a>
    </li>
  ))}
</ul>
