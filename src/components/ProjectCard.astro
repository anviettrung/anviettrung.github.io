---
import type { Project } from '../lib/projects';
import { projectHref } from '../lib/projects';
import Tag from './Tag.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, summary, year, role, tags, cover } = project.data;
const initial = title.match(/[\p{L}\p{N}]/u)?.[0] ?? '·';
---
<a href={projectHref(project)} class="group flex flex-col">
  <div class="relative aspect-[16/10] overflow-hidden rounded-xl border border-line bg-surface">
    {cover ? (
      <img
        src={cover}
        alt=""
        loading="lazy"
        class="size-full object-cover transition duration-500 group-hover:scale-[1.03]"
      />
    ) : (
      <div class="grid size-full place-items-center">
        <span class="font-mono text-3xl font-semibold text-faint/60">{initial}</span>
      </div>
    )}
  </div>
  <div class="mt-3.5 flex items-baseline justify-between gap-3">
    <h3 class="font-semibold transition-colors group-hover:text-accent">{title}</h3>
    <span class="shrink-0 font-mono text-[0.78rem] text-faint">{year}</span>
  </div>
  <p class="mt-1 text-[0.93rem] leading-relaxed text-muted">{summary}</p>
  {(role || tags.length > 0) && (
    <div class="mt-2.5 flex flex-wrap items-center gap-1.5">
      {role && <span class="mr-1 text-[0.8rem] text-faint">{role}</span>}
      {tags.slice(0, 4).map((t) => <Tag text={t} />)}
    </div>
  )}
</a>
