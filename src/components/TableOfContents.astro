---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length >= 2 && (
  <details class="toc" open>
    <summary>Mục lục</summary>
    <ol>
      {items.map((h) => (
        <li style={h.depth === 3 ? 'margin-left: 16px' : undefined}>
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}
