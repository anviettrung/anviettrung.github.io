---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Tag from '../../../../components/Tag.astro';
import TableOfContents from '../../../../components/TableOfContents.astro';
import Lightbox from '../../../../components/Lightbox.astro';
import { getReadingTimeLabel, datePathParts, slugFromId } from '../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => {
    const { year, month, day } = datePathParts(post.data.date);
    return { params: { year, month, day, slug: slugFromId(post.id) }, props: { post } };
  });
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = getReadingTimeLabel(post.body ?? '');
const dateLabel = post.data.date.toISOString().slice(0, 10);
const image = post.data.featured_image ? `/assets/images/${post.data.featured_image}` : undefined;
---
<BaseLayout title={`${post.data.title} — An's blog`} image={image}>
  <Header compact current="notes" />

  <div class="post-head" data-cat={post.data.category}>
    <div class="post-meta">
      <span>{dateLabel}</span><span class="dot">·</span><span>{readingTime}</span>
      {post.data.tags.length > 0 && <span class="dot">·</span>}
      {post.data.tags.map((tag) => <Tag text={tag} />)}
    </div>
    <h1 class="post-title">{post.data.title}</h1>
  </div>

  <TableOfContents headings={headings} />

  <article class="post-body">
    <Content />
  </article>
</BaseLayout>

<Lightbox />
