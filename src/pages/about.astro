---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site, socials, about } from '../site.config';

const timeline = [
  { title: 'Kinh nghiệm', items: about.experience },
  { title: 'Học vấn', items: about.education },
].filter((s) => s.items.length > 0);
---
<BaseLayout title="Giới thiệu">
  <h1 class="text-3xl font-semibold tracking-tight">Giới thiệu</h1>

  <div class="prose mt-8">
    {about.bio.map((p) => <p>{p}</p>)}
  </div>

  {timeline.map((section) => (
    <section class="mt-16">
      <SectionHeading title={section.title} />
      <ol class="space-y-6">
        {section.items.map((item) => (
          <li class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <span class="font-mono text-[0.8rem] text-faint tabular-nums sm:pt-0.5">{item.period}</span>
            <div>
              <p class="font-medium">
                {item.role} <span class="text-muted">· {item.org}</span>
              </p>
              {item.note && <p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{item.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}

  {about.skills.length > 0 && (
    <section class="mt-16">
      <SectionHeading title="Kỹ năng" />
      <dl class="space-y-4">
        {about.skills.map((s) => (
          <div class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <dt class="text-[0.92rem] text-faint">{s.group}</dt>
            <dd class="flex flex-wrap gap-x-4 gap-y-1">{s.items.map((i) => <span>{i}</span>)}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  <section class="mt-16">
    <SectionHeading title="Liên hệ" />
    <p class="text-muted">
      Gửi mail cho mình qua <a href={`mailto:${site.email}`} class="link text-fg">{site.email}</a>, hoặc tìm mình trên
      {' '}
      {socials
        .filter((s) => s.href.startsWith('http'))
        .map((s, i, arr) => (
          <>
            <a href={s.href} class="link text-fg">{s.label}</a>{i < arr.length - 1 ? ', ' : '.'}
          </>
        ))}
    </p>
  </section>
</BaseLayout>
