---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, socials, now } from '../site.config';
import { getPosts } from '../lib/posts';
import { getProjects } from '../lib/projects';

const posts = (await getPosts()).slice(0, 5);
const projects = await getProjects();
const featured = (projects.some((p) => p.data.featured) ? projects.filter((p) => p.data.featured) : projects).slice(0, 4);
---
<BaseLayout>
  <div>
    <section class="flex flex-col gap-7 sm:flex-row sm:items-start sm:gap-9">
      {site.avatar ? (
        <img src={site.avatar} alt={site.name} class="size-20 shrink-0 rounded-2xl object-cover" />
      ) : (
        <div class="grid size-20 shrink-0 place-items-center rounded-2xl bg-surface font-mono text-xl font-semibold text-muted ring-1 ring-line">
          {site.initials}
        </div>
      )}
      <div>
        <h1 class="text-[2.1rem] leading-tight font-semibold tracking-tight sm:text-[2.5rem]">{site.name}</h1>
        <p class="mt-1.5 font-mono text-[0.85rem] text-accent">{site.role}</p>
        <p class="mt-5 max-w-[38rem] text-[1.06rem] leading-[1.75] text-muted">{site.intro}</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                class="inline-flex items-center rounded-full border border-line px-3.5 py-1.5 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  {featured.length > 0 && (
    <section class="mt-20">
      <SectionHeading title="Dự án" href="/projects/" />
      <div class="grid gap-x-7 gap-y-10 sm:grid-cols-2">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  )}

  <div class="mt-20 grid gap-16">
    <section>
      <SectionHeading title="Bài viết gần đây" href="/blog/" />
      <PostList posts={posts} />
    </section>

    {now.length > 0 && (
      <section>
        <SectionHeading title="Hiện tại" />
        <ul class="space-y-2.5">
          {now.map((item) => (
            <li class="flex gap-3 leading-relaxed text-muted">
              <span class="mt-[0.7em] size-1.5 shrink-0 rounded-full bg-accent"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
