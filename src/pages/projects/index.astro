---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---
<BaseLayout title="Dự án" description="Các game và dự án đã làm.">
  <div class="max-w-2xl">
    <h1 class="text-3xl font-semibold tracking-tight">Dự án</h1>
    <p class="mt-3 text-muted">Game, tool và những thứ mình đã làm.</p>
  </div>
  <div class="mt-12 grid gap-x-7 gap-y-12 sm:grid-cols-2">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</BaseLayout>
